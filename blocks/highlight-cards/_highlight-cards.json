{
  "definitions": [
    {
      "title": "Highlight Cards",
      "id": "highlight-cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Highlight Cards",
              "model": "highlight-cards",
              "filter": "highlight-cards"
            }
          }
        }
      }
    },
    {
      "title": "Highlight Card",
      "id": "highlight-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Highlight Card",
              "model": "highlight-card"
            }
          }
        }
      }
    }
  ],

  "models": [
    {
      "id": "highlight-cards",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Columns",
          "description": "Number of cards shown per row",
          "value": "cols-3",
          "options": [
            {
              "name": "2 Columns",
              "value": "cols-2"
            },
            {
              "name": "3 Columns",
              "value": "cols-3"
            },
            {
              "name": "4 Columns",
              "value": "cols-4"
            }
          ]
        }
      ]
    },

    {
      "id": "highlight-card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },

        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "overlay",
          "label": "Use Image as Background",
          "description": "When enabled, text overlays the image",
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "category",
          "label": "Category"
        },

        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Rich Text"
        },

        {
          "component": "aem-content",
          "name": "cta",
          "label": "CTA Link"
        }
      ]
    }
  ],

  "filters": [
    {
      "id": "highlight-cards",
      "components": [
        "highlight-card"
      ]
    }
  ]
}
